# Synq environment template
#
# Copy this file to .env.local for local development and supply your own values.
# Never commit real credentials. Configure production values in the deployment
# platform's protected server environment unless a variable is explicitly public.

# Database — required by the running server
# Use an appropriate PostgreSQL/Supabase PostgreSQL connection string.
DATABASE_URL=

# Authentication — required in production, server-only secret
# Generate a strong, unique production value. Never reuse development secrets.
JWT_SECRET=

# Supabase Storage — required for private SynqChat attachments
# SUPABASE_SERVICE_ROLE_KEY is a critical server-only secret. Never expose it
# through a NEXT_PUBLIC_ variable or browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the private bucket used for SynqChat attachment objects.
SYNQCHAT_ATTACHMENTS_BUCKET=

# Wallet / client configuration — optional
# Client-visible by design. Required only when enabling the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# AI providers — optional alternatives, server-only secrets
# Groq is preferred when configured; OpenAI is the fallback provider. The current
# application can use built-in fallback behavior when neither key is configured.
GROQ_API_KEY=
OPENAI_API_KEY=

# Email / SMTP — required for production authentication-email delivery
# SMTP_HOST may be inferred for recognized providers, but setting it explicitly is
# recommended in production. SMTP_PORT defaults to 587 when not provider-inferred.
# SMTP_SECURE accepts true or false and otherwise follows provider/port defaults.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Optional sender identity; defaults to SMTP_USER.
SMTP_FROM=

# Optional notification configuration
# Used only when a non-auth notification recipient cannot be resolved from Synq.
# Authentication codes never use this fallback recipient.
NOTIFY_FALLBACK_EMAIL=

# Local / contract deployment tooling only — do not configure in Vercel runtime
# Hardhat has a public Sepolia RPC default when SEPOLIA_RPC_URL is omitted.
SEPOLIA_RPC_URL=
# Critical signing key used only for explicit local contract deployment commands.
# Never place this variable in Vercel Production or Preview environments.
SEPOLIA_PRIVATE_KEY=
